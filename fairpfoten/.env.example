# Kopiere diese Datei nach `.env.local` und passe die Werte an.
# .env.local wird NICHT ins Git-Repository übernommen.

# Öffentliche Basis-URL der Website (für Sitemap, Open Graph, kanonische Links)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Empfängeradresse für Termin- und Kontaktanfragen (mailto)
NEXT_PUBLIC_CONTACT_EMAIL=kontakt@example.com

# --- Für spätere Erweiterungen (aktuell NICHT verwendet) ---
# Serverseitiger E-Mail-Versand, z. B. SMTP:
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
#
# Google Calendar:
# GOOGLE_CALENDAR_ID=
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_SERVICE_ACCOUNT_KEY=
